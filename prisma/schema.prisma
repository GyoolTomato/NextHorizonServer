generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int               @id @default(autoincrement())
  localId      String            @unique
  firebaseUid  String?           @unique
  nickname     String            @default("NewUser")
  level        Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  characters   PlayerCharacter[]
  items        PlayerItem[]
  armors       PlayerArmor[]
  weapons      PlayerWeapon[]
  gachaHistory GachaHistory[]
}

model Mission {
  id       String  @id
  titleKey Int
  reward0  String?
  reward1  String?
  reward2  String?
}

model PlayerCharacter {
  id          String   @id @default(cuid())
  userId      Int
  characterId String
  quantity    Int      @default(1)
  acquiredAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model PlayerItem {
  id         String   @id @default(cuid())
  userId     Int
  itemId     String
  quantity   Int      @default(0)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model PlayerArmor {
  id         String   @id @default(cuid())
  userId     Int
  armorId    String
  quantity   Int      @default(0)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, armorId])
}

model PlayerWeapon {
  id         String   @id @default(cuid())
  userId     Int
  weaponId   String
  quantity   Int      @default(0)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weaponId])
}

model GachaBanner {
  id         String          @id
  name       String
  costType   String          @default("1010002")
  singleCost Int             @default(100)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  poolItems  GachaPoolItem[]
  histories  GachaHistory[]
}

model GachaPoolItem {
  id          String      @id @default(cuid())
  bannerId    String
  characterId String
  weight      Int
  banner      GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, characterId])
}

model GachaHistory {
  id          String      @id @default(cuid())
  userId      Int
  bannerId    String
  characterId String
  pullCount   Int
  costType    String
  costAmount  Int
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner      GachaBanner @relation(fields: [bannerId], references: [id])
}
