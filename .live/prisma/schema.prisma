generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Version {
  id          Int      @id @default(autoincrement())
  nowVersion  String   @unique
  downloadUrl String   @default("https://github.com/GyoolTomato/NextHorizon_Portfolio/releases")
  createdAt   DateTime @default(now())

  @@map("__Version")
}

model User {
  id           Int               @id @default(autoincrement())
  localId      String            @unique
  firebaseUid  String?           @unique
  nickname     String            @default("NewUser")
  level        Int               @default(1)
  exp          BigInt            @default(0)
  progressExp  BigInt            @default(0)
  lifetimeExp  BigInt            @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  characters   PlayerCharacter[]
  items        PlayerItem[]
  armors       PlayerArmor[]
  weapons      PlayerWeapon[]
  missions     PlayerMission[]
  gachaHistory GachaHistory[]
}

model PlayerMission {
  id             Int      @id @default(autoincrement())
  userId         Int
  missionKey     Int
  progress       Int      @default(0)
  isClaimed      Boolean  @default(false)
  cycleStartedAt DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey])
  @@map("PlayerMissions")
}

model PlayerCharacter {
  id           Int      @id @default(autoincrement())
  userId       Int
  characterKey Int
  stack        Int      @default(1)
  exp          BigInt   @default(0)
  level        Int      @default(1)
  grade        Int      @default(0)
  activeLv     Int      @default(0)
  charm        Int      @default(0)
  passiveLv0   Int      @default(0)
  passiveLv1   Int      @default(0)
  passiveLv2   Int      @default(0)
  acquiredAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterKey])
}

model PlayerItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  itemKey    Int
  quantity   Int      @default(0)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
}

model PlayerArmor {
  id               Int      @id @default(autoincrement())
  userId           Int
  armorKey         Int
  level            Int      @default(1)
  exp              Int      @default(0)
  equipedCharacter Int      @default(0)
  acquiredAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Armor {
  key   Int    @id
  grade String
  name  Int
  desc  Int
  icon  String
  type  String
  value Int

  @@map("_105_Armors")
}

model PlayerWeapon {
  id               Int      @id @default(autoincrement())
  userId           Int
  weaponKey        Int
  level            Int      @default(1)
  exp              Int      @default(0)
  equipedCharacter Int      @default(0)
  acquiredAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GachaBanner {
  id         Int             @id @default(autoincrement())
  name       String
  costType   String          @default("1010002")
  singleCost Int             @default(100)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  poolItems  GachaPoolItem[]
  histories  GachaHistory[]
}

model GachaPoolItem {
  id          Int         @id @default(autoincrement())
  bannerId    Int
  characterId String
  weight      Int
  banner      GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, characterId])
}

model GachaHistory {
  id          Int         @id @default(autoincrement())
  userId      Int
  bannerId    Int
  characterId String
  pullCount   Int
  costType    String
  costAmount  Int
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner      GachaBanner @relation(fields: [bannerId], references: [id])
}
